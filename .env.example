# 本地开发用的环境变量配置
# 复制此文件为 .env 并填写真实值
# Cloud Run 上通过 --set-env-vars 或 Secret Manager 注入

# Neon DB (PostgreSQL) 连接字符串
# 格式: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-proud-snow-XXXX-pooler.c-3.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Gemini API Key
GEMINI_API_KEY=AIzaSyA8hiw_WJdvU9D90nyhkny1npZkMD5a-YA

# 本地 AI 地址 (可选)
LOCAL_AI_URL=http://llm.blackrice.top/v1/chat/completions

# Moomoo OpenD Credentials
MOOMOO_ACCOUNT=your_id_here
MOOMOO_PWD=your_password_here

# Charles Schwab Developer API (Market Data - readonly)
SCHWAB_CLIENT_ID=your_schwab_client_id
SCHWAB_CLIENT_SECRET=your_schwab_client_secret
SCHWAB_REDIRECT_URI=https://developer.schwab.com/oauth2-redirect.html
SCHWAB_SCOPE=readonly
SCHWAB_TOKEN_PATH=.schwab_tokens.json

# Local after-close market data refresh.
# The backend refreshes this list once per US trading day after 16:15 ET while it is running.
MARKET_DATA_REFRESH_SYMBOLS=QQQ,VOO,SPY,^VIX,TSLA,NVDA,AAPL,MSFT,AMZN,META,GOOGL
DISABLE_MARKET_DATA_SCHEDULER=false
